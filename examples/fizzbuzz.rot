funct fizzbuzz(n) {
    i = 1
    while (i <= n) {
        if (i % 15 == 0) {
            coutln("fizzbuzz")
        }
        elseif (i % 3 == 0) {
            coutln("fizz")
        }
        elseif (i % 5 == 0) {
            coutln("buzz")
        }
        else {
            coutln(i)
        }
        i = i + 1
    }
}

fizzbuzz(15)
